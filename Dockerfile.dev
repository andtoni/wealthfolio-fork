FROM node:24.18.1-bookworm@sha256:19cd848a0e073d34bd8cd5545a1b6b4d28489b3e3b607366621ced442bd5f6b4 AS node

FROM rust:1.95.0-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1

COPY --from=node /usr/local/ /usr/local/
RUN --mount=type=cache,id=wealthfolio-dev-cargo-install-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=wealthfolio-dev-cargo-install-git,target=/usr/local/cargo/git,sharing=locked \
    sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends build-essential ca-certificates curl git libssl-dev libsqlite3-dev pkg-config \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable pnpm \
 && cargo install cargo-watch --version 8.5.3 --locked \
 && useradd --uid 1000 --create-home --shell /bin/bash developer \
 && mkdir -p /data /pnpm/store /workspace/target /usr/local/cargo/git /usr/local/cargo/registry \
 && chown -R developer:developer /data /home/developer /pnpm /workspace /usr/local/cargo/git /usr/local/cargo/registry

WORKDIR /workspace
ENV CI=1 \
    BUILD_TARGET=web \
    CARGO_TARGET_DIR=/workspace/target \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    HOME=/home/developer

USER developer
COPY --chown=developer:developer package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --chown=developer:developer apps/frontend/package.json apps/frontend/package.json
COPY --chown=developer:developer packages/addon-dev-tools/package.json packages/addon-dev-tools/package.json
COPY --chown=developer:developer packages/addon-sdk/package.json packages/addon-sdk/package.json
COPY --chown=developer:developer packages/ui/package.json packages/ui/package.json
RUN --mount=type=cache,id=wealthfolio-dev-pnpm,target=/pnpm/store,sharing=locked,uid=1000,gid=1000 \
    pnpm config set store-dir /pnpm/store \
 && pnpm install --frozen-lockfile

COPY --chown=developer:developer Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY --chown=developer:developer apps/server apps/server
COPY --chown=developer:developer apps/tauri/Cargo.toml apps/tauri/Cargo.toml
RUN mkdir -p apps/tauri/src \
 && printf 'fn main() {}\n' > apps/tauri/src/main.rs \
 && printf 'pub fn development_stub() {}\n' > apps/tauri/src/lib.rs
COPY --chown=developer:developer crates crates
RUN --mount=type=cache,id=wealthfolio-dev-cargo-registry,target=/usr/local/cargo/registry,sharing=locked,uid=1000,gid=1000 \
    --mount=type=cache,id=wealthfolio-dev-cargo-git,target=/usr/local/cargo/git,sharing=locked,uid=1000,gid=1000 \
    cargo fetch --manifest-path apps/server/Cargo.toml

COPY --chown=developer:developer . .
RUN printf 'store-dir=/pnpm/store\n' > /home/developer/.npmrc
CMD ["pnpm", "dev:web"]
