{
  "presetId": "za",
  "presetVersion": "2026-07.1",
  "name": "South Africa",
  "description": "10 common South African merchant families; no historical transactions are imported.",
  "language": "en-ZA",
  "rules": [
    {
      "key": "za.groceries-major",
      "name": "South African supermarkets",
      "pattern": "(?i)\\b(CHECKERS|SHOPRITE|PICK[ -]?N[ -]?PAY|PNP|WOOLWORTHS FOOD|SPAR|FOOD LOVERS? MARKET|BOXER)\\b",
      "matchType": "regex",
      "categoryKey": "groceries",
      "priority": 120
    },
    {
      "key": "za.groceries-delivery",
      "name": "South African grocery delivery",
      "pattern": "(?i)\\b(CHECKERS SIXTY60|SIXTY60|WOOLIES DASH|PNP ASAP)\\b",
      "matchType": "regex",
      "categoryKey": "groceries",
      "priority": 140
    },
    {
      "key": "za.coffee",
      "name": "South African coffee shops",
      "pattern": "(?i)\\b(SEATTLE COFFEE|VIDA E CAFFE|MUGG AND BEAN|MUGG & BEAN|BOOTLEGGER COFFEE|TRIBE COFFEE)\\b",
      "matchType": "regex",
      "categoryKey": "food_coffee",
      "priority": 130
    },
    {
      "key": "za.restaurants",
