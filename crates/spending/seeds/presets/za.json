      "pattern": "(?i)\\b(NANDOS|NANDO.S|SPUR STEAK|OCEAN BASKET|WIMPY|ROCOMAMAS|STEERS|DEBONAIRS|ROMANS PIZZA|CHICKEN LICKEN|KAUAI)\\b",
      "matchType": "regex",
      "categoryKey": "food_restaurants",
      "priority": 120
